					<string name="Source">messageText = &quot;Rare armor spawned!!!&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(2000*math.random() + 3000)&#13;&#10;&#13;&#10;&#9;message = Instance.new(&quot;Message&quot;)&#13;&#10;&#9;message.Text = messageText&#13;&#10;&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;&#13;&#10;&#9;wait(4)&#13;&#10;&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;</string>
